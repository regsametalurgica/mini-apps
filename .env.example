# ==========================================================
# Configurações da Aplicação CEP — Integração Protheus
# ==========================================================

# Configurações da API Protheus ERP
PROTHEUS_API_URL=http://protheus:9084/restdev
PROTHEUS_API_USER=seu_usuario_api
PROTHEUS_API_PASSWORD=sua_senha_api
PROTHEUS_ENDPOINT_CEP_LOAD=http://protheus:9084/restdev/reqop
PROTHEUS_ENDPOINT_CEP_REGISTER=http://protheus:9084/restdev/gravacep
PROTHEUS_ENDPOINT_CEP_RECURSOS=http://protheus:9084/restdev/recurso

# Servidor
PORT=3000

# Segurança (necessário apenas se usar o painel admin)
JWT_SECRET=uma_chave_secreta_longa_e_segura

# Banco de Dados (OPCIONAL — necessário apenas para o painel admin)
# Se não configurar, o sistema funciona normalmente sem banco.
# DB_HOST=localhost
# DB_USER=postgres
# DB_PASSWORD=sua_senha_aqui
# DB_NAME=miniapps
# DB_PORT=5432
